#!/bin/bash
# /usr/local/sbin/cf-actualizar-ips — regenera los snippets de nginx con los rangos IP oficiales
# de Cloudflare (realip + lista de permitidos). Solo recarga nginx si nginx -t pasa; si no, restaura.
set -euo pipefail
SN=/etc/nginx/snippets; TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
curl -fsS --max-time 30 https://www.cloudflare.com/ips-v4 -o "$TMP/v4"
curl -fsS --max-time 30 https://www.cloudflare.com/ips-v6 -o "$TMP/v6"
python3 - "$TMP/v4" "$TMP/v6" > "$TMP/lista" <<'PY'
import sys, ipaddress
out=[]
for f,ver,minimo in ((sys.argv[1],4,5),(sys.argv[2],6,3)):
    l=[x.strip() for x in open(f) if x.strip()]
    if len(l)<minimo: sys.exit(f"lista v{ver} sospechosamente corta: {len(l)}")
    for c in l:
        n=ipaddress.ip_network(c,strict=True)
        if n.version!=ver or n.prefixlen<8: sys.exit(f"CIDR invalido: {c}")
        out.append(str(n))
print("\n".join(out))
PY
FECHA=$(date -Is)
{ echo "# Generado por /usr/local/sbin/cf-actualizar-ips ($FECHA). NO editar a mano."
  echo "# Solo se incluye en los server{} de *.ziacentro.mx (detras de Cloudflare)."
  while read -r c; do echo "set_real_ip_from $c;"; done < "$TMP/lista"
  echo "real_ip_header CF-Connecting-IP;"; } > "$TMP/cloudflare-realip.conf"
{ echo "# Generado por /usr/local/sbin/cf-actualizar-ips ($FECHA). NO editar a mano."
  echo "# Solo define una variable (contexto http); no cambia nada por si sola."
  echo "# Usa \$realip_remote_addr (IP de la conexion TCP, antes de realip): allow/deny no sirve"
  echo "# porque realip ya reemplazo \$remote_addr por la IP del visitante."
  echo "geo \$realip_remote_addr \$desde_cloudflare {"; echo "    default 0;"
  while read -r c; do echo "    $c 1;"; done < "$TMP/lista"
  echo "    127.0.0.1 1;"; echo "    ::1 1;"; echo "}"; } > "$TMP/cloudflare-geo.conf"
cambio=0
for f in cloudflare-realip.conf cloudflare-geo.conf; do
  if ! diff -q <(grep -v '^# Generado' "$TMP/$f") <(D=$SN; [ $f = cloudflare-geo.conf ] && D=/etc/nginx/conf.d; grep -v '^# Generado' "$D/$f" 2>/dev/null) >/dev/null 2>&1; then cambio=1; fi
done
[ "$cambio" = 0 ] && { echo "sin cambios en rangos Cloudflare"; exit 0; }
for f in cloudflare-realip.conf cloudflare-geo.conf; do D=$SN; [ $f = cloudflare-geo.conf ] && D=/etc/nginx/conf.d; [ -f "$D/$f" ] && cp -a "$D/$f" "$TMP/$f.ant"; install -m644 "$TMP/$f" "$D/$f"; done
if nginx -t -q; then systemctl reload nginx; echo "rangos actualizados y nginx recargado"
else for f in cloudflare-realip.conf cloudflare-geo.conf; do D=$SN; [ $f = cloudflare-geo.conf ] && D=/etc/nginx/conf.d; if [ -f "$TMP/$f.ant" ]; then cp -a "$TMP/$f.ant" "$D/$f"; else rm -f "$D/$f"; fi; done
  echo "nginx -t fallo; snippets restaurados" >&2; exit 1; fi
