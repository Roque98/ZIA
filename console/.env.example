# Copiar a .env y completar. No versionar el .env.

DATABASE_URL=postgres://zia_console:cambia-esto@127.0.0.1:5432/zia_console

# 32 bytes en base64: openssl rand -base64 32
ZIA_DEVICE_SECRET=
# openssl rand -hex 32
ZIA_SESSION_SECRET=

# Solo se usan si la tabla users está vacía. Quitar la contraseña después del primer arranque.
ZIA_SEED_ADMIN_EMAIL=admin@ziacentro.mx
ZIA_SEED_ADMIN_PASSWORD=
ZIA_SEED_ADMIN_NAME=Administrador

PORT=5030
ZIA_TRUST_PROXY=1
ZIA_COOKIE_SECURE=1
ZIA_PUBLIC_URL=https://console.ziacentro.mx

# Lo que el operador configura en la app RustDesk. La clave es la pública de hbbs.
ZIA_RUSTDESK_PUBLIC_HOST=157.173.194.16
ZIA_RUSTDESK_KEY=QVacTkA79hMKrCWcwneZRKcCX4S87c7hmJNPnLEaIfs=

# Desde el propio VPS, la consola habla con hbbs/hbbr por localhost.
ZIA_RUSTDESK_ID_WS_URL=ws://127.0.0.1:21118
ZIA_RUSTDESK_RELAY_WS_URL=ws://127.0.0.1:21119

# Opcional: carpeta con index.html de una build Flutter web de RustDesk.
