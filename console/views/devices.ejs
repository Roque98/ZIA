<%- include('partials/start', { title: 'Equipos', nav: 'devices', csrf, currentUser, aviso, error: '' }) %>
<header class="page-head">
  <div>
    <h1>Equipos</h1>
    <p>PCs con RustDesk. Cada persona ve solo los que tiene asignados.</p>
  </div>
  <% if (currentUser.role === 'admin') { %>
    <a class="primary" href="/equipos/nuevo">Nuevo equipo</a>
  <% } %>
</header>

<form class="filters" method="get" action="/">
  <label>Buscar
    <input name="q" value="<%= q %>" placeholder="Nombre, ID, nota o etiqueta">
  </label>
  <label>Grupo
    <select name="grupo">
      <option value="">Todos</option>
      <% for (const group of groups) { %>
        <option value="<%= group.id %>" <%= group.id === groupId ? 'selected' : '' %>><%= group.name %></option>
      <% } %>
    </select>
  </label>
  <label>Etiqueta
    <select name="etiqueta">
      <option value="">Todas</option>
      <% for (const item of tags) { %>
        <option value="<%= item %>" <%= item === tag ? 'selected' : '' %>><%= item %></option>
      <% } %>
    </select>
  </label>
  <button type="submit" class="ghost">Filtrar</button>
</form>

<% if (!devices.length) { %>
  <section class="empty">
    <h2>No hay equipos en esta vista</h2>
    <p>
      <% if (currentUser.role === 'admin') { %>
        Da de alta el primer PC con su ID de RustDesk, o ajusta la búsqueda.
      <% } else { %>
        Cuando administración te asigne un equipo o un grupo, aparecerá aquí.
      <% } %>
    </p>
  </section>
<% } else { %>
  <div class="cards">
    <% for (const device of devices) { %>
      <article class="card">
        <header>
          <h2><%= device.name %></h2>
          <code><%= device.rustdesk_id %></code>
        </header>
        <% if (device.tags.length) { %>
          <ul class="chips">
            <% for (const item of device.tags) { %><li><%= item %></li><% } %>
          </ul>
        <% } %>
        <p class="meta">
          <% if (device.group_names.length) { %>
            <%= device.group_names.join(' · ') %>
          <% } else { %>
            Sin grupo
          <% } %>
          <% if (device.has_password) { %> · contraseña guardada<% } %>
          <% if (currentUser.role === 'admin') { %>
            · <%= device.direct_users %> personas, <%= device.direct_groups %> grupos de personas
          <% } %>
        </p>
        <% if (device.notes) { %><p class="notes"><%= device.notes %></p><% } %>
        <footer>
          <a class="primary" href="/sesion/<%= device.id %>">Conectar</a>
          <% if (currentUser.role === 'admin') { %>
            <a class="ghost" href="/equipos/<%= device.id %>">Editar</a>
          <% } %>
        </footer>
      </article>
    <% } %>
  </div>
<% } %>
<%- include('partials/end') %>
