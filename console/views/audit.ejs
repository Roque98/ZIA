<%- include('partials/start', { title: 'Auditoría', nav: 'audit', csrf, currentUser, aviso, error: '' }) %>
<header class="page-head">
  <div>
    <h1>Auditoría</h1>
    <p>Entradas, cambios de equipos y permisos, y cada sesión remota.</p>
  </div>
  <a class="ghost" href="/auditoria.csv?accion=<%= filters.action %>&actor=<%= filters.actor %>&desde=<%= filters.desde %>&hasta=<%= filters.hasta %>">Exportar CSV</a>
</header>
<form class="filters" method="get" action="/auditoria">
  <label>Acción
    <select name="accion">
      <option value="">Todas</option>
      <% for (const action of actions) { %>
        <option value="<%= action %>" <%= filters.action === action ? 'selected' : '' %>><%= action %></option>
      <% } %>
    </select>
  </label>
  <label>Correo
    <input name="actor" value="<%= filters.actor %>" placeholder="quien hizo la acción">
  </label>
  <label>Desde <input name="desde" type="date" value="<%= filters.desde %>"></label>
  <label>Hasta <input name="hasta" type="date" value="<%= filters.hasta %>"></label>
  <button class="ghost" type="submit">Filtrar</button>
</form>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Cuándo</th>
        <th>Quién</th>
        <th>Acción</th>
        <th>Equipo / objeto</th>
        <th>IP</th>
        <th>Detalle</th>
      </tr>
    </thead>
    <tbody>
      <% if (!events.length) { %>
        <tr><td colspan="6">No hay eventos con ese filtro.</td></tr>
      <% } %>
      <% for (const event of events) { %>
        <tr>
          <td><time datetime="<%= event.occurred_at.toISOString() %>"><%= event.occurred_at.toISOString().replace('T', ' ').slice(0, 19) %></time></td>
          <td><%= event.actor_email || '—' %></td>
          <td><code><%= event.action %></code></td>
          <td><%= event.entity_type || '' %> <%= event.entity_id || '' %></td>
          <td><%= event.ip || '' %></td>
          <td class="detail"><%= JSON.stringify(event.detail) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/end') %>
